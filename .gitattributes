# Normalize line endings for all text files to LF in the repo,
# checked out as LF on Linux/Mac and CRLF on Windows.
* text=auto

# Explicitly LF for source files (never CRLF in the repo)
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary — never touch line endings
*.png  binary
*.jpg  binary
*.xlsx binary
*.twbx binary
*.pdf  binary
